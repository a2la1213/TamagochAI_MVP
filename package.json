{
  "name": "tamagochai",
  "version": "0.1.0",
  "description": "TamagochAI — Une conscience numérique évolutive qui vit dans ton téléphone",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "dev": "expo start --tunnel",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "build:apk": "eas build --platform android --profile production",
    "lint": "npx tsc --noEmit"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-asset": "^12.0.12",
    "expo-battery": "~8.0.0",
    "expo-constants": "^18.0.13",
    "expo-file-system": "^19.0.21",
    "expo-font": "^14.0.11",
    "expo-notifications": "^0.29.14",
    "expo-sqlite": "~15.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-safe-area-context": "~4.14.0",
    "react-native-screens": "~4.4.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.3.0",
    "babel-preset-expo": "~12.0.0",
    "typescript": "~5.3.0"
  },
  "private": true
}
