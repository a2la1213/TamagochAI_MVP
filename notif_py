    isEnabled = true;
    await setSetting('notifications_enabled', 'true');

    const savedLastTime = await getSetting('last_notification_time');
    if (savedLastTime) {
      lastNotificationTime = parseInt(savedLastTime, 10);
    }

    startNotificationCycle();
